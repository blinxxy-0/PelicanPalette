    {
      "Action": "EditData",
      "Target": "Characters/Dialogue/rainy",
      "Entries": {
        "Sable": "Rain's the best light there is. Flat and honest. Nothing to hide behind.#$b#...I'm painting inside today anyway. The canvases hate the damp."
      }
    },

    // ---- The festivals ----
    { "Action": "Include", "FromFile": "data/sable_festivals.json" },

    // ---- First visit: hanging the commission board, three canvases and a jar of rose ----
    { "Action": "Load", "Target": "Data/Events/blinxxy.MuseArt_ArtShop", "FromFile": "data/blank.json" },
    {
      "Action": "EditData",
      "Target": "Data/Events/blinxxy.MuseArt_ArtShop",
      "Entries": {
        "blinxxy.MuseArt_SableIntro/": "continue/7 6/farmer 7 9 0 Sable 9 4 0/skippable/pause 500/move farmer 0 -3 0/pause 300/speak Sable \"Left a little... no. Right. ...Hm.$u\"/pause 300/emote Sable 16/faceDirection Sable 2/pause 300/move Sable -1 0 3/move Sable 0 2 2/faceDirection Sable 3/faceDirection farmer 1/speak Sable \"Oh. A customer. Or a lost farmer. Same thing, in my experience.$u#$b#I'm Sable. This is the shop. Canvases, pigments, brushes. And I buy paintings, if you make any worth buying.\"/pause 300/speak Sable \"Here. Three canvases and a jar of rose. The first ones are free. That's how they get you.$h\"/addItem (O)blinxxy.MuseArt_Canvas_Small 3/addItem (O)blinxxy.MuseArt_Pigment_rose 1/pause 300/speak Sable \"The board's for commissions. People in town want paintings of the things they love. Paint them well and they'll pay you. They'll like you more, too.#$b#The counter's open ten till six. Go make something.\"/friendship Sable 25/pause 300/end"
      }
    },

    // ---- The grand opening letter, with two canvases to start ----
    {
      "Action": "EditData",
      "Target": "Data/mail",
      "Entries": {
        "blinxxy.MuseArt_GrandOpening": "Hello, new neighbor.^I've opened an art supply shop in Cindersap Forest, west of the path down from Marnie's. Canvases, pigments, brushes and frames, and I buy paintings, if you ever pick up a brush.^I've put two canvases in with this. No pressure. (Some pressure.)^Open 10am to 6pm (Fridays till 5, Sundays from 1). Closed Wednesdays.^   -Sable %item id (O)blinxxy.MuseArt_Canvas_Small 2 %%[#]The art shop opens"
      }
    },
