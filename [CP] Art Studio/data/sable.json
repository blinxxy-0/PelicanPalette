      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        "blinxxy.MuseArt_GrandOpening": {
          "Id": "blinxxy.MuseArt_GrandOpening",
          "Trigger": "DayStarted",
          "Condition": "DAYS_PLAYED 2, !PLAYER_HAS_MAIL Current blinxxy.MuseArt_GrandOpening Any",
          "Actions": [ "AddMail Current blinxxy.MuseArt_GrandOpening" ]
        }
