// Tess Brand (1.4): the Vale's woodcarver, Bram Fairlie's granddaughter (she doesn't
// say so until her 6-heart event). She/her; early twenties; marriageable by any farmer,
// 1.4's third romance with Fern and Emmett. Moves into Studio III on Winter 1, Year 3.
// See docs/tess_brief.md and docs/design/vale_newcomers.md.
//
// SWITCHED OFF until the art exists: every patch here has the same When, so TessBrand
// only exists once the dev pack's config has ValeResidents: true AND both
// assets/tess/sprites.png (Characters/TessBrand) and assets/tess/portraits.png
// (Portraits/TessBrand) are in this pack. See data/residents.json.
//
// Her marriage: data/tess_marriage.json (docs/tess_marriage.md).
{
  "Changes": [
    // ---- Who she is ----
    {
      "Action": "EditData",
      "Target": "Data/Characters",
      "When": {"ValeResidents": "true", "HasFile:assets/tess/sprites.png": "true", "HasFile:assets/tess/portraits.png": "true"},
      "Entries": {
        "TessBrand": {
          "DisplayName": "{{i18n:tess.name}}",
          "Gender": "Female",
          "Age": "Adult",
          // serious, private, stubborn; dry once she trusts you (the game's generic lines)
          "Manner": "Neutral",
          "SocialAnxiety": "Shy",
          "Optimism": "Neutral",
          // Fall 25: when the Vale's trees have dropped their gold and the wood shows. Free in
          // vanilla, the mod and Stardew Valley Expanded (its fall birthdays are the 7th, 8th
          // and 28th; checked 2026-11-09), and no festival.
          "BirthSeason": "Fall",
          "BirthDay": 25,
          // From the Vale, not the town: no introductions quest, and not on the calendar or
          // social page until you've met her.
          "HomeRegion": "Other",
          "CanBeRomanced": true,
          // Moves in on Winter 1, Year 3 (docs/design/vale_newcomers.md section 3: after the
          // For Sale notice, the Sold notice and Robin's renovation): from Year 3, in its
          // winter or any later year. Like Kent, no arrival trigger: she's simply there. And,
          // like the other residents, not until the Vale's route is open (the letter,
          // ArtStudio/Vale/ValeBus.cs; in a dev save add the mail flag blinxxy.MuseArt_ValeOpen).
          "UnlockConditions": "YEAR 3, ANY \"YEAR 4\" \"SEASON Winter\", PLAYER_HAS_MAIL Host blinxxy.MuseArt_ValeOpen Any",
          "Calendar": "HiddenUntilMet",
          "SocialTab": "HiddenUntilMet",
          "IntroductionsQuest": false,
          // Not at Pelican Town's festivals yet, not anyone's Winter Star secret friend while
          // she's away from town, and no Ginger Island trips (as the other residents).
          "FlowerDanceCanDance": false,
          "WinterStarParticipant": "FALSE",
          "CanVisitIsland": "FALSE",
          "Home": [
            // Studio III, between her bed (her bedroll at first) and the door: a tile clear in
            // every stage of the room (tools/build_vale_buildings.py studio3_0 to _3)
            { "Id": "Default", "Location": "blinxxy.MuseArt_ValeStudio3", "Tile": { "X": 4, "Y": 9 }, "Direction": "up" }
          ]
        }
      }
    },
    { "Action": "Load", "Target": "Characters/TessBrand", "FromFile": "assets/tess/sprites.png", "When": {"ValeResidents": "true", "HasFile:assets/tess/sprites.png": "true", "HasFile:assets/tess/portraits.png": "true"} },
    { "Action": "Load", "Target": "Portraits/TessBrand", "FromFile": "assets/tess/portraits.png", "When": {"ValeResidents": "true", "HasFile:assets/tess/sprites.png": "true", "HasFile:assets/tess/portraits.png": "true"} },
    // ---- Gifts: love / like / dislike / hate / neutral (text, then item IDs) ----
    // Loves Hardwood, Mahogany Seed, Pine Tar, Maple Syrup, Pumpkin Soup; likes Wood, Oak
    // Resin, any cooked dish (she's broke); dislikes Sap and Joja Cola; hates Trash and the
    // Broken CD ("anything plastic-looking"). Paintings: the mod's rule; an art lover.
    {
      "Action": "EditData",
      "Target": "Data/NPCGiftTastes",
      "When": {"ValeResidents": "true", "HasFile:assets/tess/sprites.png": "true", "HasFile:assets/tess/portraits.png": "true"},
      "Entries": { "TessBrand": "{{i18n:tess.gift.love}}/709 292 726 724 236/{{i18n:tess.gift.like}}/388 725 -7/{{i18n:tess.gift.dislike}}/92 167/{{i18n:tess.gift.hate}}/168 171/{{i18n:tess.gift.neutral}}/" }
    },

    // ---- A day in her life (data/tess_schedule.json) ----
    { "Action": "Load", "Target": "Characters/schedules/TessBrand", "FromFile": "data/tess_schedule.json", "When": {"ValeResidents": "true", "HasFile:assets/tess/sprites.png": "true", "HasFile:assets/tess/portraits.png": "true"} },
    // Tuesdays, the first bus to Robin's (a four-hour walk each way: there by about 10) for
    // timber and, later, joinery; home by 6. Behind the town-trips switch like the others' days in town
    // (data/vale_town_trips.json has the buses' NPC warps).
    {
      "Action": "EditData",
      "Target": "Characters/schedules/TessBrand",
      "When": { "ValeResidents": "true", "ValeResidentsTownTrips": "true", "HasFile:assets/tess/sprites.png": "true", "HasFile:assets/tess/portraits.png": "true" },
      "Entries": {
        "Tue": "600 ScienceHouse 8 20 0/1400 blinxxy.MuseArt_ValeStudio3 7 5 0/2200 blinxxy.MuseArt_ValeStudio3 4 9 0"
      }
    },

    // ---- What she says (data/tess_dialogue.json, written by tools/tess_dialogue.py) ----
    { "Action": "Include", "FromFile": "data/tess_dialogue.json" },

    // ---- Her heart events (data/tess_events.json, written by tools/build_tess_events.py) ----
    { "Action": "Include", "FromFile": "data/tess_events.json" },
    // ... and what her 8-heart event leaves: Bram's stone, carved (tools/build_tess_bram_stone.py)
    { "Action": "Include", "FromFile": "data/tess_bram_stone.json" },

    // ---- Married (data/tess_marriage.json, written by tools/build_tess_marriage.py) ----
    { "Action": "Include", "FromFile": "data/tess_marriage.json" }
  ]
}
