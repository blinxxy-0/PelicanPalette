// The old painters' guide (the Vale painters' guide design, section 4): the book itself and the
// quest that counts its eight spots; and the Gilded Grove (section 5), where its last page leads. ArtStudio/Vale/PaintersGuide.cs gives both (TakeGuide) and
// writes the quest's objective as spots are found.
//
// The guide is a Quest-type object that can't be given, trashed or sold. Its icon is a thin,
// paint-spotted leather book with a red ribbon (assets/PaintersGuide.png, tools/art/vale_guide_final.py).
{
  "Changes": [
    {
      "Action": "Load",
      "Target": "Mods/blinxxy.MuseArt.Vale/PaintersGuide",
      "FromFile": "assets/PaintersGuide.png"
    },
    {
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "blinxxy.MuseArt_PaintersGuide": {
          "Name": "blinxxy.MuseArt_PaintersGuide",
          "DisplayName": "{{i18n:vale.guide.page.title}}",
          "Description": "{{i18n:vale.guide.item.description}}",
          "Type": "Quest",
          "Category": 0,
          "Price": 0,
          "Texture": "Mods/blinxxy.MuseArt.Vale/PaintersGuide",
          "SpriteIndex": 0,
          "CanBeGivenAsGift": false,
          "CanBeTrashed": false,
          "ExcludeFromRandomSale": true,
          "ExcludeFromFishingCollection": true,
          "ExcludeFromShippingCollection": true,
          "ContextTags": [ "not_giftable", "not_placeable" ]
        }
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/Quests",
      "Entries": {
        // Basic: Type/Title/Description/Objective/NextQuests/Money/Reward/Cancellable/Reaction.
        // Not cancellable; no reward (the Grove is the reward).
        "blinxxy.MuseArt_PaintersGuide": "Basic/{{i18n:quest.painters_guide.title}}/{{i18n:quest.painters_guide.description}}/{{i18n:quest.painters_guide.objective|found=0}}/null/-1/0/-1/false"
      }
    },
    // The Grove's own context: painted light doesn't change, so it's fall there all year (the game
    // swaps the map's spring_ sheets for their fall faces by the location's season) and never rains.
    // The map names this context itself (its LocationContext property): Data/Locations has no field for it.
    {
      "Action": "EditData",
      "Target": "Data/LocationContexts",
      "Entries": {
        "blinxxy.MuseArt_GroveContext": {
          "SeasonOverride": "fall",
          "AllowRainTotem": false,
          "WeatherConditions": [ { "Id": "Sun", "Weather": "Sun" } ]
        }
      }
    },
    // ---- The painted fish: bites only in the Grove's pool (Data/Locations below), and in no other water.
    // Not one of the Vale's five (data/vale_fish.json) and not a paint ingredient. Its id carries the
    // Vale fish prefix (not the mod's own blinxxy.MuseArt_), so a still life of it fills the painting
    // record's Fish tab like theirs do. Its icon is gold and cream, its scales laid on in vermilion brushstrokes
    // (assets/PaintedFish.png, tools/art/vale_guide_final.py). ----
    {
      "Action": "Load",
      "Target": "Mods/blinxxy.MuseArt.Vale/PaintedFish",
      "FromFile": "assets/PaintedFish.png"
    },
    {
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "blinxxy.MuseArt.Vale_PaintedFish": {
          "Name": "Painted Fish",
          "DisplayName": "{{i18n:fish.painted.name}}",
          "Description": "{{i18n:fish.painted.description}}",
          "Type": "Fish",
          "Category": -4,
          "Price": 450,
          "Texture": "Mods/blinxxy.MuseArt.Vale/PaintedFish",
          "SpriteIndex": 0,
          "Edibility": 10,
          "ContextTags": [ "color_yellow", "fish_has_roe", "fish_lake", "season_spring", "season_summer", "season_fall", "season_winter" ]
        }
      }
    },
    // name/difficulty/motion/min size/max size/times/seasons/weather/(unused)/max depth/spawn chance/depth multiplier/min fishing level/tutorial
    {
      "Action": "EditData",
      "Target": "Data/Fish",
      "Entries": {
        "blinxxy.MuseArt.Vale_PaintedFish": "Painted Fish/75/smooth/10/30/600 2600/spring summer fall winter/both/684 .35/3/.3/.1/0/false"
      }
    },
    // The Grove (tools/build_vale_grove.py): reached only by the guide, left only by its frame
    // (ArtStudio/Vale/GildedGrove.cs). Nothing grows or spawns there, and it isn't on anyone's way.
    // Its pool is fishable: the painted fish bites here and nowhere else (it's rare: most casts catch
    // the game's usual junk instead).
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_GildedGrove": {
          "DisplayName": "{{i18n:location.gilded-grove}}",
          "DefaultArrivalTile": { "X": 12, "Y": 11 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_GildedGrove" },
          "ExcludeFromNpcPathfinding": true,
          "CanPlantHere": false,
          "ArtifactSpots": [],
          "Forage": [],
          "Fish": [
            { "Id": "blinxxy.MuseArt.Vale_PaintedFish", "ItemId": "(O)blinxxy.MuseArt.Vale_PaintedFish", "Chance": 0.4 }
          ],
          "MinDailyWeeds": 0,
          "MaxDailyWeeds": 0,
          "FirstDayWeedMultiplier": 0,
          "MinDailyForageSpawn": 0,
          "MaxDailyForageSpawn": 0,
          "ChanceForClay": 0
        }
      }
    }
  ]
}
