// The Gilded Vale on the world map (M): a region of its own, as Ginger Island has (and
// Ridgeside Village does), so the map shows the Vale while you're there and the valley
// everywhere else. The picture is 300x180 like the game's: the real Vale map traced
// (art/gilded_vale/worldmap/), redrawn in the world map's style.
//
// Where things sit: the Vale's 96x76 tiles fill pixels 42,5 to 258,176 of the picture
// (2.25 pixels a tile), so a tile x,y is pixel 42 + 2.25x, 5 + 2.25y. Inside a building
// you're shown on it, in the middle of its picture on the map (checked on all four seasons).
{
  "Changes": [
    // The picture, with a season's version where there is one.
    {
      "Action": "Load",
      "Target": "Mods/blinxxy.MuseArt/ValeWorldMap",
      "FromFile": "assets/ValeWorldMap.png",
      "Priority": "Low"
    },
    {
      "Action": "Load",
      "Target": "Mods/blinxxy.MuseArt/ValeWorldMap",
      "FromFile": "assets/ValeWorldMap_{{season}}.png",
      "When": { "HasFile:assets/ValeWorldMap_{{season}}.png": "true" }
    },
    {
      "Action": "EditData",
      "Target": "Data/WorldMap",
      "Entries": {
        "blinxxy.MuseArt_GildedVale": {
          "BaseTexture": [
            { "Id": "Default", "Texture": "Mods/blinxxy.MuseArt/ValeWorldMap" }
          ],
          "MapAreas": [
            // ---- The buildings: a tooltip each, and where you're shown inside ----
            {
              "Id": "ValeHouse",
              "PixelArea": { "X": 95, "Y": 23, "Width": 24, "Height": 27 },
              "ScrollText": "{{i18n:location.vale-house}}",
              "Tooltips": [
                { "Id": "ValeHouse", "Text": "{{i18n:worldmap.vale-house}}" }
              ],
              "WorldPositions": [
                { "Id": "ValeHouse", "LocationName": "blinxxy.MuseArt_ValeHouse", "MapPixelArea": { "X": 107, "Y": 36, "Width": 1, "Height": 1 } }
              ]
            },
            {
              "Id": "TeaGarden",
              "PixelArea": { "X": 119, "Y": 25, "Width": 15, "Height": 23 },
              "Tooltips": [
                { "Id": "TeaGarden", "Text": "{{i18n:worldmap.tea-garden}}" }
              ]
            },
            {
              "Id": "Pottery",
              "PixelArea": { "X": 135, "Y": 25, "Width": 24, "Height": 23 },
              "ScrollText": "{{i18n:location.vale-pottery}}",
              "Tooltips": [
                { "Id": "Pottery", "Text": "{{i18n:worldmap.vale-pottery}}" }
              ],
              "WorldPositions": [
                { "Id": "Pottery", "LocationName": "blinxxy.MuseArt_ValePottery", "MapPixelArea": { "X": 147, "Y": 36, "Width": 1, "Height": 1 } }
