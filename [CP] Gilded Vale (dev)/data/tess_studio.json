        "blinxxy.MuseArt_Vale.studio3.counter": "{{i18n:vale.studio3.counter}}",
        "blinxxy.MuseArt_Vale.studio3.bram_chair": "{{i18n:vale.studio3.bram_chair}}",
        "blinxxy.MuseArt_Vale.studio3.carving_1": "{{i18n:vale.studio3.carving_1}}",
        "blinxxy.MuseArt_Vale.studio3.carving_2": "{{i18n:vale.studio3.carving_2}}",
        "blinxxy.MuseArt_Vale.studio3.carving_3": "{{i18n:vale.studio3.carving_3}}",
        "blinxxy.MuseArt_Vale.studio3.carving_4": "{{i18n:vale.studio3.carving_4}}",
