  "spring": "600 blinxxy.MuseArt_GildedVale 19 37 3/800 blinxxy.MuseArt_ValeStudio2 14 10 0/1300 blinxxy.MuseArt_ValeStudio2 13 5 0/1700 blinxxy.MuseArt_ValeStudio2 16 5 0/2100 blinxxy.MuseArt_ValeStudio2 18 6 2",
  // Rain: no walk; the workshop all day.
  "rain": "800 blinxxy.MuseArt_ValeStudio2 14 10 0/1300 blinxxy.MuseArt_ValeStudio2 13 5 0/2100 blinxxy.MuseArt_ValeStudio2 18 6 2",
  // Winter: a later dawn walk, then the kiln keeps him in.
  "winter": "630 blinxxy.MuseArt_GildedVale 19 37 3/830 blinxxy.MuseArt_ValeStudio2 16 5 0/1200 blinxxy.MuseArt_ValeStudio2 14 10 0/2100 blinxxy.MuseArt_ValeStudio2 18 6 2"
