// Emmett Wren (1.4): the Vale's folk fiddler. He/him; marriageable by any farmer,
// one of 1.4's two romances. His cottage is beside the amphitheatre. His arc is
// belonging, not performance. See docs/emmett_brief.md.
//
// SWITCHED OFF until the art exists: every patch here has the same When, so
// EmmettWren only exists once the dev pack's config has ValeResidents: true AND both
// assets/emmett/sprites.png (Characters/EmmettWren) and assets/emmett/portraits.png
// (Portraits/EmmettWren) are in this pack. See data/residents.json.
{
  "Changes": [
    // ---- Who he is ----
    {
      "Action": "EditData",
      "Target": "Data/Characters",
      "When": {"ValeResidents": "true", "HasFile:assets/emmett/sprites.png": "true", "HasFile:assets/emmett/portraits.png": "true"},
      "Entries": {
        "EmmettWren": {
          "DisplayName": "{{i18n:emmett.name}}",
          "Gender": "Male",
          "Age": "Adult",
          "Manner": "Neutral",
          "SocialAnxiety": "Outgoing",
          "Optimism": "Positive",
          "BirthSeason": "Spring",
          "BirthDay": 9,
          // From the Vale, not the town: no introductions quest, and not on the
          // calendar or social page until you've met them.
          "HomeRegion": "Other",
          // Datable, as the brief says (see the note on marriage in emmett_dialogue.json).
          "CanBeRomanced": true,
          // Not in the world until the Vale's route is open (the letter that opens it,
          // ArtStudio/Vale/ValeBus.cs OpenMail). In a dev save without that letter, add
          // the mail flag blinxxy.MuseArt_ValeOpen to see them.
          "UnlockConditions": "PLAYER_HAS_MAIL Host blinxxy.MuseArt_ValeOpen Any",
          "Calendar": "HiddenUntilMet",
          "SocialTab": "HiddenUntilMet",
          "IntroductionsQuest": false,
          // Not at Pelican Town's festivals yet (no festival places, no dance frames),
          // not drawn as anyone's Winter Star secret friend while away from town, and
          // no Ginger Island trips (no beach outfit, and the island visit starts in town).
          "FlowerDanceCanDance": false,
          "WinterStarParticipant": "FALSE",
          "CanVisitIsland": "FALSE",
          "Home": [
            // His cottage, by his bed in the nook.
            { "Id": "Default", "Location": "blinxxy.MuseArt_ValeEmmett", "Tile": { "X": 6, "Y": 6 }, "Direction": "down" }
          ]
        }
      }
    },
    { "Action": "Load", "Target": "Characters/EmmettWren", "FromFile": "assets/emmett/sprites.png", "When": {"ValeResidents": "true", "HasFile:assets/emmett/sprites.png": "true", "HasFile:assets/emmett/portraits.png": "true"} },
    { "Action": "Load", "Target": "Portraits/EmmettWren", "FromFile": "assets/emmett/portraits.png", "When": {"ValeResidents": "true", "HasFile:assets/emmett/sprites.png": "true", "HasFile:assets/emmett/portraits.png": "true"} },

    // ---- Gifts: love / like / dislike / hate / neutral (text, then item IDs) ----
    // Loves: a good meal (Pumpkin Soup, Fish Stew), Pale Ale, a Chanterelle ('tastes
    // like autumn'). Likes: most cooked food, fruit, beer, amethysts ('good for the
    // throat, my nan said'). Dislikes what's only expensive (gold bars, diamonds) and
    // raw ore. Hates slime and trash. ('Anything you made yourself' is a love the gift
    // table can't say; his events can.)
    // Paintings: the mod's rule; an art lover (data/residents.json).
    {
      "Action": "EditData",
      "Target": "Data/NPCGiftTastes",
      "When": {"ValeResidents": "true", "HasFile:assets/emmett/sprites.png": "true", "HasFile:assets/emmett/portraits.png": "true"},
      "Entries": { "EmmettWren": "{{i18n:emmett.gift.love}}/236 728 303 281/{{i18n:emmett.gift.like}}/-7 -79 346 66/{{i18n:emmett.gift.dislike}}/336 72 378 380 384 386/{{i18n:emmett.gift.hate}}/766 168/{{i18n:emmett.gift.neutral}}/" }
    },

    // ---- A day in his life (data/emmett_schedule.json) ----
    { "Action": "Load", "Target": "Characters/schedules/EmmettWren", "FromFile": "data/emmett_schedule.json", "When": {"ValeResidents": "true", "HasFile:assets/emmett/sprites.png": "true", "HasFile:assets/emmett/portraits.png": "true"} },

    // ---- What he says ----
    { "Action": "Include", "FromFile": "data/emmett_dialogue.json" }
  ]
}
