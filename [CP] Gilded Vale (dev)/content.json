    // The Exhibition Hall is closed and dusty until Lupini's 8-heart event reopens it: its
    // closed map (ValeHallClosed.tmx, "hall_closed" in tools/build_vale_buildings.py) until the
    // player has the mail flag blinxxy.MuseArt_ValeHallOpen, then the open hall. The flag is a
    // placeholder: the 8-heart event (not written yet) will set it.
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_ValeHall", "FromFile": "assets/ValeHallClosed.tmx", "Priority": "Low" },
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_ValeHall", "FromFile": "assets/ValeHall.tmx", "When": { "HasFlag": "blinxxy.MuseArt_ValeHallOpen" } },
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_ValeFern", "FromFile": "assets/ValeFern.tmx" },
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_ValeEmmett", "FromFile": "assets/ValeEmmett.tmx" },
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_ValeStudio", "FromFile": "assets/ValeStudio.tmx" },
    { "Action": "Load", "Target": "Mods/blinxxy.MuseArt/ValeWallpapers", "FromFile": "assets/ValeWallpapers.png" },
    {
      "Action": "EditData",
      "Target": "Data/AdditionalWallpaperFlooring",
      "Entries": {
        "blinxxy.MuseArt_ValeWallpapers": { "Id": "blinxxy.MuseArt_ValeWallpapers", "Texture": "Mods/blinxxy.MuseArt/ValeWallpapers", "IsFlooring": false, "Count": 1 }
      }
    },
    // The five residents (1.4): data, gifts, schedules and dialogue, switched off until
    // their art exists (data/residents.json says what turns each one on).
    { "Action": "Include", "FromFile": "data/residents.json" },
    // The old painters' guide and its quest, and the Gilded Grove its last page leads to
    // (data/vale_guide.json; the Grove's map is built by tools/build_vale_grove.py).
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_GildedGrove", "FromFile": "assets/GildedGrove.tmx" },
    { "Action": "Include", "FromFile": "data/vale_guide.json" },
    // The Vale on the world map (M), a region of its own.
    { "Action": "Include", "FromFile": "data/vale_worldmap.json" },
    // The Vale's own fish, and the game's river and lake fish in its water.
    { "Action": "Include", "FromFile": "data/vale_fish.json" },
    // Pathoschild's Central Station, when it's installed, runs the bus: the Vale is one of
    // its stops (ArtStudio/Vale/ValeBus.cs is the bus without it). Open once the route's
    // letter has come and the bus is mended, as for the Desert.
    {
      "Action": "EditData",
      "Target": "Mods/Pathoschild.CentralStation/Stops",
      "When": { "HasMod": "Pathoschild.CentralStation" },
      "Entries": {
        "{{ModId}}_GildedVale": {
          "DisplayName": "{{i18n:location.gilded-vale}}",
          "ToLocation": "blinxxy.MuseArt_GildedVale",
          "ToTile": { "X": 3, "Y": 8 },
          "ToFacingDirection": "down",
          "Network": "Bus",
          "Cost": 300,
          "Condition": "PLAYER_HAS_MAIL Host blinxxy.MuseArt_ValeOpen, PLAYER_HAS_MAIL Host ccVault"
        }
      }
    },
    // CJB Cheats Menu's Warps tab, when it's installed: a Gilded Vale section with the bus
    // stop (where the bus lets you off, ValeBus.cs StepOff) and the tile outside each
    // building's front door (where its exit puts you, the Warp in each interior's map),
    // listed after CJB's own sections (Order 100-700). Check them in a debug build with
    // museart_cjbwarps.
    {
      "Action": "EditData",
      "Target": "Mods/CJBok.CheatsMenu/WarpSections",
      "When": { "HasMod": "CJBok.CheatsMenu" },
      "Entries": {
        "{{ModId}}_GildedVale": { "Id": "{{ModId}}_GildedVale", "DisplayName": "{{i18n:location.gilded-vale}}", "Order": 800 }
      }
    },
    {
      "Action": "EditData",
      "Target": "Mods/CJBok.CheatsMenu/Warps",
      "When": { "HasMod": "CJBok.CheatsMenu" },
      "Entries": {
        "{{ModId}}_BusStop": { "Id": "{{ModId}}_BusStop", "SectionId": "{{ModId}}_GildedVale", "DisplayName": "{{i18n:warp.bus-stop}}", "Location": "blinxxy.MuseArt_GildedVale", "Tile": "3, 8", "Order": -1 },
        "{{ModId}}_ValeHouse": { "Id": "{{ModId}}_ValeHouse", "SectionId": "{{ModId}}_GildedVale", "DisplayName": "{{i18n:location.vale-house}}", "Location": "blinxxy.MuseArt_GildedVale", "Tile": "28, 20" },
        "{{ModId}}_Pottery": { "Id": "{{ModId}}_Pottery", "SectionId": "{{ModId}}_GildedVale", "DisplayName": "{{i18n:location.vale-pottery}}", "Location": "blinxxy.MuseArt_GildedVale", "Tile": "44, 18" },
        "{{ModId}}_Atelier": { "Id": "{{ModId}}_Atelier", "SectionId": "{{ModId}}_GildedVale", "DisplayName": "{{i18n:location.vale-atelier}}", "Location": "blinxxy.MuseArt_GildedVale", "Tile": "73, 24" },
