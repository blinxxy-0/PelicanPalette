{
  "Format": "2.9.0",
  "Changes": [
    // The Gilded Vale (1.4), in development: the map built by tools/build_vale.py
    // (painted terrain, the five buildings, PixelLab stairs; other buildings still
    // boxes). No way in yet but `museart_warp blinxxy.MuseArt_GildedVale 20 7`.
    // This pack is deployed by Debug builds only and never released (ArtStudio.csproj).
    {
      "Action": "Load",
      "Target": "Maps/blinxxy.MuseArt_GildedVale",
      "FromFile": "assets/GildedVale.tmx"
    },
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_GildedVale": {
          "DisplayName": "{{i18n:location.gilded-vale}}",
          "DefaultArrivalTile": { "X": 20, "Y": 7 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_GildedVale" }
        },
        // The interiors (tools/build_vale_interiors.py): decoratable, so the game
        // papers and floors their walls itself.
        "blinxxy.MuseArt_ValeHouse": {
          "DisplayName": "{{i18n:location.vale-house}}",
          "DefaultArrivalTile": { "X": 15, "Y": 28 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ValeHouse", "Type": "StardewValley.Locations.DecoratableLocation" }
        },
        // The other buildings (tools/build_vale_buildings.py)
        "blinxxy.MuseArt_ValePottery": {
          "DisplayName": "{{i18n:location.vale-pottery}}",
          "DefaultArrivalTile": { "X": 8, "Y": 21 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ValePottery", "Type": "StardewValley.Locations.DecoratableLocation" }
        },
        "blinxxy.MuseArt_ValeAtelier": {
          "DisplayName": "{{i18n:location.vale-atelier}}",
          "DefaultArrivalTile": { "X": 7, "Y": 19 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ValeAtelier", "Type": "StardewValley.Locations.DecoratableLocation" }
        },
        "blinxxy.MuseArt_ValeHall": {
          "DisplayName": "{{i18n:location.vale-hall}}",
          "DefaultArrivalTile": { "X": 14, "Y": 21 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ValeHall", "Type": "StardewValley.Locations.DecoratableLocation" }
        },
        "blinxxy.MuseArt_ValeFern": {
          "DisplayName": "{{i18n:location.vale-fern}}",
          "DefaultArrivalTile": { "X": 6, "Y": 19 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ValeFern", "Type": "StardewValley.Locations.DecoratableLocation" }
        },
        "blinxxy.MuseArt_ValeEmmett": {
          "DisplayName": "{{i18n:location.vale-emmett}}",
          "DefaultArrivalTile": { "X": 10, "Y": 16 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ValeEmmett", "Type": "StardewValley.Locations.DecoratableLocation" }
        }
      }
    },
    // What the Vale's pieces say when you right-click them (tools/build_vale_buildings.py,
    // "describe": Action Message on the piece and its plaque)
