<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ArtStudio</AssemblyName>
    <RootNamespace>ArtStudio</RootNamespace>
    <Version>1.3.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableHarmony>true</EnableHarmony>
    <ModFolderName>PelicanPalette</ModFolderName>
    <!-- .NET 6 is past end of life, but it's what Stardew 1.6 runs on. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- SpaceCore is built against a newer System.Reflection.Metadata; the game supplies its own at runtime. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <!-- The pottery prototype's art (1.5, in development, Debug only like its code) never ships. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IgnoreModFilePatterns>assets[/\\]pottery[/\\]</IgnoreModFilePatterns>
  </PropertyGroup>

  <!-- The Content Patcher pack (the shop's building, interior and stock) deploys alongside. -->
  <ItemGroup>
    <ContentPacks Include="..\[CP] Pelican Palette" Version="$(Version)" />
  </ItemGroup>

  <!-- The Gilded Vale (1.4) is in development: its pack deploys to the dev Mods folder
       in Debug builds only, and is never in a Release build or zip (the user,
       2026-11-04: not in any release until they say so). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ContentPacks Include="..\[CP] Gilded Vale (dev)" Version="0.1.0" />
  </ItemGroup>

  <!-- The Automate support DLL (ArtStudio.Automate): built first, then copied
       beside ArtStudio.dll, which must not reference it (SMAPI would then
       need Automate to load the mod). -->
  <ItemGroup>
    <ProjectReference Include="..\ArtStudio.Automate\ArtStudio.Automate.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\ArtStudio.Automate\bin\$(Configuration)\net6.0\ArtStudio.Automate.dll" Link="ArtStudio.Automate.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- SpaceCore provides the custom skill framework; it's installed alongside, never bundled. -->
  <ItemGroup>
    <Reference Include="SpaceCore">
      <HintPath>$(GamePath)\Mods\SpaceCore\SpaceCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- SMAPI's TMX library, used by the debug map exporter. -->
    <Reference Include="TMXTile">
      <HintPath>$(GamePath)\smapi-internal\TMXTile.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
