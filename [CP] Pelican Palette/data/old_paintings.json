// Old paintings (1.3): the Travelling Cart now and then sells a damaged one,
// from any set, for anyone unlucky finding them (one day in six). The rest
// turn up from digs, treasure and crates (ArtStudio/Painting/OldPaintingFinds.cs).
{
  "Changes": [
    // The museum collection's rewards by letter, from Gunther (the C# mod
    // sends each once it's earned and its letter exists: Social/MuseumCollection.cs).
    {
      "Action": "EditData",
      "Target": "Data/mail",
      "Entries": {
        "blinxxy.MuseArt_Collection_set-wreck": "{{i18n:mail.collection-wreck}} %item id (O)blinxxy.MuseArt_DriftwoodFrame 2 %%[#]{{i18n:mail.collection-wreck.title}}",
        "blinxxy.MuseArt_Collection_set-miners": "{{i18n:mail.collection-miners}} %item id (O)blinxxy.MuseArt_IronFrame 2 %%[#]{{i18n:mail.collection-miners.title}}",
        "blinxxy.MuseArt_Collection_set-calico": "{{i18n:mail.collection-calico}} %item id (O)blinxxy.MuseArt_SandstoneFrame 2 %%[#]{{i18n:mail.collection-calico.title}}",
        "blinxxy.MuseArt_Collection_set-dwarvish": "{{i18n:mail.collection-dwarvish}} %item id (O)blinxxy.MuseArt_DwarvishFrame 2 %%[#]{{i18n:mail.collection-dwarvish.title}}",
        // The Old Valley: the gallery's furniture, one piece to a letter (a
        // letter carries one item).
        "blinxxy.MuseArt_Collection_set-valley": "{{i18n:mail.collection-valley}} %item id (F)blinxxy.MuseArt_GalleryBench 1 %%[#]{{i18n:mail.collection-valley.title}}",
        "blinxxy.MuseArt_Collection_set-valley-rope": "{{i18n:mail.collection-valley-rope}} %item id (F)blinxxy.MuseArt_VelvetRope 1 %%[#]{{i18n:mail.collection-valley-rope.title}}",
        "blinxxy.MuseArt_Collection_set-valley-plinth": "{{i18n:mail.collection-valley-plinth}} %item id (F)blinxxy.MuseArt_MarblePlinth 1 %%[#]{{i18n:mail.collection-valley-plinth.title}}",
        // Six donated: the living painting.
        "blinxxy.MuseArt_Collection_count-6": "{{i18n:mail.collection-6}} %item id (F)blinxxy.MuseArt_LivingPainting 1 %%[#]{{i18n:mail.collection-6.title}}",
        // Twelve: Margot's loupe.
        "blinxxy.MuseArt_Collection_count-12": "{{i18n:mail.collection-12}} %item id (O)blinxxy.MuseArt_MargotsLoupe 1 %%[#]{{i18n:mail.collection-12.title}}",
        // All 21: the paint-tube Junimo from Sable's gallery.
        "blinxxy.MuseArt_Collection_count-21": "{{i18n:mail.collection-21}} %item id (F)blinxxy.MuseArt_PaintTubeJunimo 1 %%[#]{{i18n:mail.collection-21.title}}"
      }
    },
    // Margot's loupe: worn like a ring (a trinket needs Combat Mastery's slot,
    // out of most painters' reach), and while it's on, old paintings turn up
    // half as often again (ArtStudio/Painting/OldPaintingFinds.cs).
    { "Action": "Load", "Target": "Mods/blinxxy.MuseArt/Loupe", "FromFile": "assets/collection/loupe.png" },
    {
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "blinxxy.MuseArt_MargotsLoupe": {
          "Name": "blinxxy.MuseArt_MargotsLoupe",
          "DisplayName": "{{i18n:item.loupe}}",
          "Description": "{{i18n:item.loupe.description}}",
          "Type": "Ring",
          "Category": -96,
          "Price": 1500,
          "Texture": "Mods/blinxxy.MuseArt/Loupe",
          "SpriteIndex": 0,
          "ExcludeFromShippingCollection": true,
          "ExcludeFromRandomSale": true
        }
      }
    },
    { "Action": "Load", "Target": "Mods/blinxxy.MuseArt/Gallery", "FromFile": "assets/collection/gallery.png" },
    // (Four frames side by side: ArtStudio/Painting/LivingPainting.cs steps through them.)
    { "Action": "Load", "Target": "Mods/blinxxy.MuseArt/LivingPainting", "FromFile": "assets/collection/living.png" },
    {
      "Action": "EditData",
      "Target": "Data/Furniture",
      "Entries": {
        // name/type/sheet size/bounding box/rotations/price/placement/display name/sprite index/texture/off limits for sale
        "blinxxy.MuseArt_VelvetRope": "blinxxy.MuseArt_VelvetRope/decor/2 2/2 1/1/500/-1/{{i18n:item.velvet-rope}}/0/Mods\\blinxxy.MuseArt\\Gallery/true",
        "blinxxy.MuseArt_GalleryBench": "blinxxy.MuseArt_GalleryBench/bench/2 2/2 1/1/750/-1/{{i18n:item.gallery-bench}}/2/Mods\\blinxxy.MuseArt\\Gallery/true",
        // A marble plinth (a table: set something on it). It replaced a picture light before 1.3 shipped.
        "blinxxy.MuseArt_MarblePlinth": "blinxxy.MuseArt_MarblePlinth/table/1 2/1 1/1/500/-1/{{i18n:item.marble-plinth}}/39/Mods\\blinxxy.MuseArt\\Gallery/true",
        "blinxxy.MuseArt_PaintTubeJunimo": "blinxxy.MuseArt_PaintTubeJunimo/decor/3 3/3 1/1/5000/-1/{{i18n:item.paint-tube-junimo}}/12/Mods\\blinxxy.MuseArt\\Gallery/true",
        "blinxxy.MuseArt_LivingPainting":"blinxxy.MuseArt_LivingPainting/painting/2 2/2 2/1/2000/-1/{{i18n:item.living-painting}}/0/Mods\\blinxxy.MuseArt\\LivingPainting/true"
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/Shops",
      "TargetField": [ "Traveler", "Items" ],
      "Entries": {
        "blinxxy.MuseArt_DamagedPainting": {
          "Id": "blinxxy.MuseArt_DamagedPainting",
          "RandomItemId": [
            "(O)blinxxy.MuseArt_DamagedPainting_valley",
            "(O)blinxxy.MuseArt_DamagedPainting_wreck",
            "(O)blinxxy.MuseArt_DamagedPainting_miners",
            "(O)blinxxy.MuseArt_DamagedPainting_calico",
            "(O)blinxxy.MuseArt_DamagedPainting_dwarvish"
          ],
          "Price": 3000,
          "AvailableStock": 1,
          "Condition": "SYNCED_RANDOM day blinxxy.MuseArt_OldPaintingCart 0.17"
        }
      }
    }
  ]
}
