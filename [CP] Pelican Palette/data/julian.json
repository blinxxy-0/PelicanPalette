// Julian Vane (1.2): the city art critic who reviewed Sable's first show ten
// years ago. He/him; not marriageable. He lives in Zuzu City (an unseen
// location, below) and visits the valley the 22nd to the 24th of every
// season, off the morning bus and back on the evening one: the C# mod
// keeps him out of sight before 10am and after he's back at the bus stop
// (Social/Julian.cs). See docs/julian_brief.md.
{
  "Changes": [
    // ---- Who he is ----
    {
      "Action": "EditData",
      "Target": "Data/Characters",
      "Entries": {
        "JulianVane": {
          "DisplayName": "{{i18n:julian.name}}",
          "Gender": "Male",
          "Age": "Adult",
          "Manner": "Rude",
          "SocialAnxiety": "Outgoing",
          "Optimism": "Negative",
          "BirthSeason": "Winter",
          "BirthDay": 22,
          // Not from around here: no town introductions, and not on the
          // calendar or social page until you've met him.
          "HomeRegion": "Other",
          "CanBeRomanced": false,
          "Calendar": "HiddenUntilMet",
          "SocialTab": "UnknownUntilMet",
          "IntroductionsQuest": false,
          "FlowerDanceCanDance": false,
          "Home": [
            // Always his home off the map ("Zuzu City"). On visit mornings the
            // mod moves him to the bus door and routes his day from there
            // (Social/Julian.cs): a home by the bus on visit days didn't work,
            // since the game picks the home the night before, on the 21st.
            { "Id": "Default", "Location": "blinxxy.MuseArt_JulianHome", "Tile": { "X": 1, "Y": 1 }, "Direction": "down" }
          ]
        }
      }
    },
    { "Action": "Load", "Target": "Characters/JulianVane", "FromFile": "assets/julian/sprites.png" },
    { "Action": "Load", "Target": "Portraits/JulianVane", "FromFile": "assets/julian/portraits.png" },
    {
      "Action": "EditData",
      "Target": "Mods/Bouhm.NPCMapLocations/NPCs",
      "Entries": { "JulianVane": { "MarkerCropOffset": 2 } },
      "When": { "HasMod": "Bouhm.NPCMapLocations" }
    },

    // ---- Where he is between visits ----
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_JulianHome", "FromFile": "assets/JulianHome.tmx" },
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_JulianHome": {
          "DisplayName": "{{i18n:location.zuzu-city}}",
          "DefaultArrivalTile": { "X": 1, "Y": 1 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_JulianHome" }
        }
      }
    },

    // ---- Gifts: love / like / dislike / hate / neutral ----
    // Loves: wine, truffle oil, prismatic shards (and fine paintings, which
    // the C# mod handles for everyone). Likes cheese and preserves. Hates
    // Joja Cola, slime and seaweed.
    {
      "Action": "EditData",
      "Target": "Data/NPCGiftTastes",
      "Entries": {
        "JulianVane": "{{i18n:julian.gift.love}}/348 432 74/{{i18n:julian.gift.like}}/424 426 344 340/{{i18n:julian.gift.dislike}}/346 92 330/{{i18n:julian.gift.hate}}/167 766 152/{{i18n:julian.gift.neutral}}/"
      }
    },

    // ---- His visits ----
    {
      "Action": "Load",
      "Target": "Characters/schedules/JulianVane",
      "FromFile": "data/julian_schedule.json"
    },
    { "Action": "Include", "FromFile": "data/julian_dialogue.json" },
    // His heart events (tools/build_julian_events.py, from docs/julian_events.md).
    { "Action": "Include", "FromFile": "data/julian_events.json" },

    // ---- The things in his story (tools/art/julian_items.py) ----
    // The catalogue from Sable's first show (his 8 hearts: you give it to
    // Sable), and his review of Sable's new painting, framed (10 hearts).
    { "Action": "Load", "Target": "Mods/blinxxy.MuseArt/JulianItems", "FromFile": "assets/julian/items.png" },
    {
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "blinxxy.MuseArt_OldCatalogue": {
          "Name": "blinxxy.MuseArt_OldCatalogue",
          "DisplayName": "{{i18n:julian.item.catalogue}}",
          "Description": "{{i18n:julian.item.catalogue.description}}",
          "Type": "Quest",
          "Category": 0,
          "Price": 0,
          "Texture": "Mods/blinxxy.MuseArt/JulianItems",
          "SpriteIndex": 0,
          "Edibility": -300,
          "ExcludeFromShippingCollection": true,
          "ExcludeFromRandomSale": true
        }
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/Furniture",
      "Entries": {
        // name/type/sheet size/bounding box/rotations/price/placement/display name/sprite index/texture/off limits for sale
        "blinxxy.MuseArt_JulianReview": "blinxxy.MuseArt_JulianReview/painting/2 2/2 2/1/500/-1/{{i18n:julian.item.review}}/1/Mods\\blinxxy.MuseArt\\JulianItems/true",
        // The Fair painting contest's ribbons (1.2): first, second, third.
        "blinxxy.MuseArt_Ribbon1": "blinxxy.MuseArt_Ribbon1/painting/1 1/1 1/1/250/-1/{{i18n:contest.ribbon.1}}/3/Mods\\blinxxy.MuseArt\\JulianItems/true",
        "blinxxy.MuseArt_Ribbon2": "blinxxy.MuseArt_Ribbon2/painting/1 1/1 1/1/150/-1/{{i18n:contest.ribbon.2}}/4/Mods\\blinxxy.MuseArt\\JulianItems/true",
        "blinxxy.MuseArt_Ribbon3": "blinxxy.MuseArt_Ribbon3/painting/1 1/1 1/1/100/-1/{{i18n:contest.ribbon.3}}/5/Mods\\blinxxy.MuseArt\\JulianItems/true"
      }
    },
    // The Fair: Julian judges the painting contest at a table by the grange
    // display (the contest itself is ArtStudio/Social/PaintingContest.cs).
    {
      "Action": "EditData",
      "Target": "Data/Festivals/fall16",
      "Entries": { "JulianVane": "{{i18n:contest.festival}}" },
      "TextOperations": [
        { "Operation": "Append", "Target": [ "Entries", "Set-Up_additionalCharacters" ], "Value": "JulianVane 48 59 2", "Delimiter": "/" }
      ],
      "When": { "HasMod |contains=FlashShifter.StardewValleyExpandedCP": false }
    },
    // (Stardew Valley Expanded fills that corner: on the grass by the lamp, left of the north road.)
    {
      "Action": "EditData",
      "Target": "Data/Festivals/fall16",
      "Entries": { "JulianVane": "{{i18n:contest.festival}}" },
      "TextOperations": [
        { "Operation": "Append", "Target": [ "Entries", "Set-Up_additionalCharacters" ], "Value": "JulianVane 18 51 2", "Delimiter": "/" }
      ],
      "When": { "HasMod |contains=FlashShifter.StardewValleyExpandedCP": true }
    },
    // The tourist beside his table (a figure painted into the Fair's map) talks
    // about the contest instead.
    {
      "Action": "EditData",
      "Target": "Strings/StringsFromMaps",
      "When": { "HasMod |contains=FlashShifter.StardewValleyExpandedCP": false },     // (with SVE the table's elsewhere, so they keep SVE's line)
      "Entries": { "Town-Fair.4": "{{i18n:contest.tourist}}" }
    },
    // Giving the catalogue to Sable: what they say depends on how close you are.
    // Either way, they keep it (and Julian's last event can follow).
    {
      "Action": "EditData",
      "Target": "Characters/Dialogue/Sable",
      "Entries": { "AcceptGift_(O)blinxxy.MuseArt_OldCatalogue": "{{i18n:sable.catalogue.cold}}$action AddMail Current blinxxy.MuseArt_CatalogueGiven Received" },
      "When": { "Hearts:Sable": "0, 1, 2, 3" }
    },
    {
      "Action": "EditData",
      "Target": "Characters/Dialogue/Sable",
      "Entries": { "AcceptGift_(O)blinxxy.MuseArt_OldCatalogue": "{{i18n:sable.catalogue.warm}}$action AddMail Current blinxxy.MuseArt_CatalogueGiven Received" },
      "When": { "Hearts:Sable|contains=0, 1, 2, 3": "false" }
    }
  ]
}
