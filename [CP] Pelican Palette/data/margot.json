// Margot Pell (1.3): the conservator from the Zuzu City museum, sent when
// old paintings start turning up in the valley. She/her; marriage candidate.
// She arrives the week after the first damaged old painting is found
// (Gunther writes first; ArtStudio/Social/Margot.cs sets the flag), and
// lives in a room of her own down a few steps from the Saloon's storeroom (the Saloon's
// only bedroom is Gus's). See docs/conservator_brief.md.
// (Heart events, the wedding and married life come in later pack files.)
{
  "Changes": [
    // ---- Who she is ----
    {
      "Action": "EditData",
      "Target": "Data/Characters",
      "Entries": {
        "MargotPell": {
          "DisplayName": "{{i18n:margot.name}}",
          "Gender": "Female",
          "Age": "Adult",
          "Manner": "Polite",
          "SocialAnxiety": "Outgoing",
          "Optimism": "Positive",
          "BirthSeason": "Spring",
          "BirthDay": 19,
          "HomeRegion": "Town",
          "CanBeRomanced": true,
          // Not in the valley until she's sent for.
          "UnlockConditions": "PLAYER_HAS_MAIL Host blinxxy.MuseArt_MargotArrived Any",
          "Calendar": "HiddenUntilMet",
          "SocialTab": "HiddenUntilMet",
          "IntroductionsQuest": false,
          // She dances (frames 40-47), and has the kiss (28), working at an
          // easel from behind (32-34) and sleeping (39), as Sable's sheet.
          "FlowerDanceCanDance": true,
          "KissSpriteIndex": 28,
          "KissSpriteFacingRight": true,
          // Married: her conservation corner in the farmhouse (her restoration
          // table, where she stands), and on the patio an easel and a rack of
          // her own small canvases (she paints there from behind: frames 32-34).
          "SpouseRoom": { "MapAsset": "blinxxy.MuseArt_MargotSpouseRoom", "MapSourceRect": { "X": 0, "Y": 0, "Width": 6, "Height": 9 } },
          "SpousePatio": {
            "MapAsset": "blinxxy.MuseArt_MargotSpousePatio",
            "MapSourceRect": { "X": 0, "Y": 0, "Width": 4, "Height": 4 },
            "SpriteAnimationFrames": [ [ 32, 300 ], [ 32, 300 ], [ 33, 300 ], [ 33, 300 ], [ 32, 300 ], [ 33, 300 ], [ 34, 1500 ] ]
          },
          // A coat and scarf outdoors in winter, linen on Ginger Island.
          "Appearance": [
            { "Id": "Winter", "Season": "Winter", "Indoors": false, "Outdoors": true, "Portrait": "Portraits/MargotPell_Winter", "Sprite": "Characters/MargotPell_Winter" },
            { "Id": "Island", "IsIslandAttire": true, "Portrait": "Portraits/MargotPell_Beach", "Sprite": "Characters/MargotPell_Beach" }
          ],
          // Her room down the steps from the Saloon's storeroom.
          "Home": [
            { "Id": "Default", "Location": "blinxxy.MuseArt_MargotRoom", "Tile": { "X": 6, "Y": 6 }, "Direction": "down" }
          ]
        }
      }
    },
    { "Action": "Load", "Target": "Characters/MargotPell", "FromFile": "assets/margot/sprites.png" },
    { "Action": "Load", "Target": "Portraits/MargotPell", "FromFile": "assets/margot/portraits.png" },
    { "Action": "Load", "Target": "Characters/MargotPell_Winter", "FromFile": "assets/margot/sprites_winter.png" },
    { "Action": "Load", "Target": "Portraits/MargotPell_Winter", "FromFile": "assets/margot/portraits_winter.png" },
    { "Action": "Load", "Target": "Characters/MargotPell_Beach", "FromFile": "assets/margot/sprites_beach.png" },
    { "Action": "Load", "Target": "Portraits/MargotPell_Beach", "FromFile": "assets/margot/portraits_beach.png" },
    // Her wedding dress, worn only for the ceremony.
    { "Action": "Load", "Target": "Characters/MargotPell_Wedding", "FromFile": "assets/margot/sprites_wedding.png" },
    { "Action": "Load", "Target": "Portraits/MargotPell_Wedding", "FromFile": "assets/margot/portraits_wedding.png" },
    {
      "Action": "EditData",
      "Target": "Mods/Bouhm.NPCMapLocations/NPCs",
      "Entries": { "MargotPell": { "MarkerCropOffset": 2 } },
      "When": { "HasMod": "Bouhm.NPCMapLocations" }
    },
    {
      "Action": "EditData",
      "Target": "Data/AnimationDescriptions",
      "Entries": {
        "margot_work": "34/32 32 32 33 33 33 32 32 32 33 33 33 34 34 34 34 34 34/34",
        "margot_sleep": "39/39/39"
      }
    },

    // ---- Her room (tools/build_margot_room.py) ----
    // Down a short flight of steps from Gus's storeroom upstairs, between
    // the barrels, like the steps down to Sebastian's room at Robin's (the
    // same tiles), against the storeroom's right wall. The storeroom has three empty rows beneath it before the
    // arcade's wall, in vanilla and in Stardew Valley Expanded alike; only
    // the steps' own tiles change, so SVE's storeroom floor stays its own.
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_MargotRoom", "FromFile": "assets/MargotRoom.tmx" },
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_MargotSpouseRoom", "FromFile": "assets/MargotSpouseRoom.tmx" },
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_MargotSpousePatio", "FromFile": "assets/MargotSpousePatio.tmx" },
    // Once she's moved to her cottage, Gus makes it his guest room: the
    // whole room laid over hers (new furniture, and new walls the game
    // papers afresh). An edit, not a second Load: the location is created
    // before the flag can be read.
    {
      "Action": "EditMap", "Target": "Maps/blinxxy.MuseArt_MargotRoom", "FromFile": "assets/MargotGuestRoom.tmx",
      "PatchMode": "Replace",
      "When": { "HasFlag |contains=blinxxy.MuseArt_MargotCottageBuilt": true }
    },
    // The mod's wallpapers (a real wallpaper set, so it papers her room the
    // way the farmhouse's walls are papered): the sage damask is pattern 0,
    // then the guest room's.
    { "Action": "Load", "Target": "Mods/blinxxy.MuseArt/Wallpapers", "FromFile": "assets/Wallpapers.png" },
    // Her 10-heart paintings (tools/art/margot_items.py): what you paint
    // together. ("You, by Margot" is painted from your own sprite in the
    // game, ArtStudio/Painting/FarmerPortrait.cs.)
    { "Action": "Load", "Target": "Mods/blinxxy.MuseArt/MargotItems", "FromFile": "assets/margot/items.png" },
    {
      "Action": "EditData",
      "Target": "Data/Furniture",
      "Entries": {
        // name/type/sheet size/bounding box/rotations/price/placement/display name/sprite index/texture/off limits for sale
        "blinxxy.MuseArt_MargotByYou": "blinxxy.MuseArt_MargotByYou/painting/2 2/2 2/1/500/-1/{{i18n:margot.item.margot-by-you}}/0/Mods\\blinxxy.MuseArt\\MargotItems/true",
        "blinxxy.MuseArt_NorthWindow": "blinxxy.MuseArt_NorthWindow/painting/2 2/2 2/1/500/-1/{{i18n:margot.item.north-window}}/2/Mods\\blinxxy.MuseArt\\MargotItems/true"
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/AdditionalWallpaperFlooring",
      "Entries": {
        "blinxxy.MuseArt_Wallpapers": { "Id": "blinxxy.MuseArt_Wallpapers", "Texture": "Mods/blinxxy.MuseArt/Wallpapers", "IsFlooring": false, "Count": 4 }
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_MargotRoom": {
          "DisplayName": "{{i18n:location.margot-room}}",
          "DefaultArrivalTile": { "X": 5, "Y": 8 },
          // Decoratable, like the farmhouse: the game papers its walls (the
          // map's WallIDs: her sage damask) and floors it.
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_MargotRoom", "Type": "StardewValley.Locations.DecoratableLocation" }
        }
      }
    },
    {
      "Action": "EditMap",
      "Target": "Maps/Saloon",
      "MapTiles": [
        // The storeroom's bottom edge opens beside its right wall, which
        // carries straight on down past the steps (its rounded corner goes).
        { "Position": { "X": 35, "Y": 9 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 162 },
        { "Position": { "X": 36, "Y": 9 }, "Layer": "Front", "Remove": true },
        { "Position": { "X": 37, "Y": 9 }, "Layer": "Front", "Remove": true },
        { "Position": { "X": 38, "Y": 9 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 68 },
        // The steps, two wide, and their walls.
        { "Position": { "X": 36, "Y": 10 }, "Layer": "Back", "SetTilesheet": "1", "SetIndex": 1043 },
        { "Position": { "X": 37, "Y": 10 }, "Layer": "Back", "SetTilesheet": "1", "SetIndex": 1043 },
        { "Position": { "X": 36, "Y": 11 }, "Layer": "Back", "SetTilesheet": "1", "SetIndex": 1075 },
        { "Position": { "X": 37, "Y": 11 }, "Layer": "Back", "SetTilesheet": "1", "SetIndex": 1075 },
        { "Position": { "X": 36, "Y": 10 }, "Layer": "Buildings", "Remove": true },
        { "Position": { "X": 37, "Y": 10 }, "Layer": "Buildings", "Remove": true },
        { "Position": { "X": 36, "Y": 11 }, "Layer": "Buildings", "Remove": true },
        { "Position": { "X": 37, "Y": 11 }, "Layer": "Buildings", "Remove": true },
        { "Position": { "X": 35, "Y": 11 }, "Layer": "Buildings", "SetTilesheet": "1", "SetIndex": 0 },
        { "Position": { "X": 38, "Y": 10 }, "Layer": "Buildings", "SetTilesheet": "1", "SetIndex": 0 },
        { "Position": { "X": 38, "Y": 11 }, "Layer": "Buildings", "SetTilesheet": "1", "SetIndex": 0 },
        { "Position": { "X": 35, "Y": 10 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 64 },
        { "Position": { "X": 38, "Y": 10 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 68 },
        { "Position": { "X": 35, "Y": 11 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 96 },
        { "Position": { "X": 36, "Y": 11 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 165 },
        { "Position": { "X": 37, "Y": 11 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 165 },
        { "Position": { "X": 38, "Y": 11 }, "Layer": "Front", "SetTilesheet": "1", "SetIndex": 130 }
      ],
      "TextOperations": [
        { "Operation": "Append", "Target": [ "MapProperties", "Warp" ], "Value": "36 10 blinxxy.MuseArt_MargotRoom 5 8 37 10 blinxxy.MuseArt_MargotRoom 5 8", "Delimiter": " " }
      ]
    },

    // ---- Her cottage (tools/build_margot_cottage.py) ----
    // Built by Robin after her 4-heart event, between the main road and the
    // river south of Haley and Emily's: the back of the house faces us, a
    // big window to the water, and the door's at the right-hand end, by the
    // cherry tree. The patch only adds its own tiles (Overlay), so the
    // ground is the town's own, vanilla or Stardew Valley Expanded.
    {
      "Action": "EditMap",
      "Target": "Maps/Town",
      "FromFile": "assets/MargotCottagePatch.tmx",
      "ToArea": { "X": 18, "Y": 91, "Width": 6, "Height": 8 },
      "PatchMode": "Overlay",
      "MapTiles": [
        { "Position": { "X": 21, "Y": 96 }, "Layer": "Buildings", "SetProperties": { "Action": "LockedDoorWarp 6 8 blinxxy.MuseArt_MargotCottage 900 2200" } },
        // The town's bush on the plot (its spawn tile); Social/Margot.cs
        // clears the bush itself from saves that already have it.
        { "Position": { "X": 19, "Y": 94 }, "Layer": "Paths", "Remove": true }
      ],
      "When": { "HasFlag |contains=blinxxy.MuseArt_MargotCottageBuilt": true }
    },
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_MargotCottage", "FromFile": "assets/MargotCottage.tmx" },
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_MargotCottage": {
          "DisplayName": "{{i18n:location.margot-cottage}}",
          "DefaultArrivalTile": { "X": 6, "Y": 8 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_MargotCottage", "Type": "StardewValley.Locations.DecoratableLocation" }
        }
      }
    },

    // ---- Gifts: love / like / dislike / hate / neutral ----
    // Loves: green tea, rhubarb pie, the ancient doll, the golden mask,
    // diamonds (and fine paintings, which the C# mod handles for everyone).
    // Likes coffee, cheese, honey, quartz and earth crystals. Dislikes sap
    // and Joja Cola; hates slime, trash and green algae.
    {
      "Action": "EditData",
      "Target": "Data/NPCGiftTastes",
      "Entries": {
        "MargotPell": "{{i18n:margot.gift.love}}/614 222 103 124 72/{{i18n:margot.gift.like}}/395 424 340 80 86/{{i18n:margot.gift.dislike}}/92 167/{{i18n:margot.gift.hate}}/766 168 153/{{i18n:margot.gift.neutral}}/"
      }
    },

    // ---- Her arrival: Gunther's letter ----
    {
      "Action": "EditData",
      "Target": "Data/mail",
      "Entries": {
        "blinxxy.MuseArt_MargotLetter": "{{i18n:mail.margot-letter}}[#]{{i18n:mail.margot-letter.title}}",
        // Robin, when the cottage is done (her 4-heart event, three days on).
        "blinxxy.MuseArt_MargotCottageLetter": "{{i18n:mail.margot-cottage}}[#]{{i18n:mail.margot-cottage.title}}"
      }
    },

    // ---- A day in her life ----
    // Her day; from her 4-heart move, home is the cottage.
    {
      "Action": "Load", "Target": "Characters/schedules/MargotPell", "FromFile": "data/margot_schedule.json",
      "When": { "HasFlag |contains=blinxxy.MuseArt_MargotCottageBuilt": false }
    },
    {
      "Action": "Load", "Target": "Characters/schedules/MargotPell", "FromFile": "data/margot_schedule_cottage.json",
      "When": { "HasFlag |contains=blinxxy.MuseArt_MargotCottageBuilt": true }
    },
    { "Action": "Include", "FromFile": "data/margot_dialogue.json" },
    // Her heart events (tools/build_margot_events.py, from docs/margot_events.md).
    { "Action": "Include", "FromFile": "data/margot_events.json" },
    // Her wedding (tools/build_margot_wedding.py).
    { "Action": "Include", "FromFile": "data/margot_wedding.json" },
    // Her engagement and married lines (tools/build_margot_marriage.py).
    { "Action": "Include", "FromFile": "data/margot_marriage.json" }
  ]
}
