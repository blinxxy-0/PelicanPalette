// The museum's painting wing (1.3, docs/design/museum_wing.md): a gallery for
// the 21 restored old paintings, off the museum's east wall. Its map is
// tools/build_museum_wing.py; the game hangs what you've donated
// (ArtStudio/Social/PaintingWing.cs).
{
  "Changes": [
    { "Action": "Load", "Target": "Maps/blinxxy.MuseArt_PaintingWing", "FromFile": "assets/PaintingWing.tmx" },
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_PaintingWing": {
          "DisplayName": "{{i18n:location.painting-wing}}",
          "DefaultArrivalTile": { "X": 3, "Y": 24 },
          // Decoratable, like Margot's rooms: the game papers its walls.
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_PaintingWing", "Type": "StardewValley.Locations.DecoratableLocation" }
        }
      }
    },
    // The doorway: an opening in the exhibit hall's east wall, at the foot of
    // its east room (only these tiles change, so Stardew Valley Expanded's
    // museum keeps its own). Until your first donation the game ropes it off
    // (PaintingWing.cs).
    {
      "Action": "EditMap",
      "Target": "Maps/ArchaeologyHouse",
      "MapTiles": [
        { "Position": { "X": 49, "Y": 15 }, "Layer": "Back", "SetTilesheet": "untitled tile sheet", "SetIndex": 124 },
        { "Position": { "X": 49, "Y": 16 }, "Layer": "Back", "SetTilesheet": "untitled tile sheet", "SetIndex": 124 },
        { "Position": { "X": 49, "Y": 15 }, "Layer": "Buildings", "Remove": true },
        { "Position": { "X": 49, "Y": 16 }, "Layer": "Buildings", "Remove": true },
        { "Position": { "X": 49, "Y": 15 }, "Layer": "Front", "Remove": true },
        { "Position": { "X": 49, "Y": 16 }, "Layer": "Front", "Remove": true },
        // The wall's edge, turned along the top and bottom of the opening:
        // above it, the end the library passage's wall has (its 193), and
        // below it the same, flipped, so the edge starts again cleanly into
        // the room's corner.
        { "Position": { "X": 49, "Y": 14 }, "Layer": "Front", "SetTilesheet": "untitled tile sheet", "SetIndex": 193 },
        { "Position": { "X": 49, "Y": 17 }, "Layer": "Front", "SetTilesheet": "untitled tile sheet", "SetIndex": 193, "SetProperties": { "@Flip": "2" } }
      ]
    },
    // The way through, only once the wing's open (the morning after your
    // first donation, when the rope comes down): you come in a step inside,
    // clear of the doorway.
    {
      "Action": "EditMap",
      "Target": "Maps/ArchaeologyHouse",
      "TextOperations": [
        { "Operation": "Append", "Target": [ "MapProperties", "Warp" ], "Value": "49 15 blinxxy.MuseArt_PaintingWing 3 24 49 16 blinxxy.MuseArt_PaintingWing 3 25", "Delimiter": " " }
      ],
      "When": { "HasFlag |contains=blinxxy.MuseArt_PaintingWingOpen": true }
    },
    {
      "Action": "EditData",
      "Target": "Data/Furniture",
      "Entries": {
        // A missing painting's card, and the doorway's rope (the game places both).
        "blinxxy.MuseArt_WingCard": "blinxxy.MuseArt_WingCard/painting/1 1/1 1/1/0/-1/{{i18n:item.wing-card}}/10/Mods\\blinxxy.MuseArt\\Gallery/true",
        "blinxxy.MuseArt_WingRope": "blinxxy.MuseArt_WingRope/decor/1 3/1 2/1/0/-1/{{i18n:item.velvet-rope}}/30/Mods\\blinxxy.MuseArt\\Gallery/true",
        // A white marble display for a painting, three tiles wide (the game
        // draws the painting on its board).
        "blinxxy.MuseArt_WingDisplay": "blinxxy.MuseArt_WingDisplay/decor/3 4/3 1/1/0/-1/{{i18n:item.wing-display}}/15/Mods\\blinxxy.MuseArt\\Gallery/true"
      }
    }
  ]
}
