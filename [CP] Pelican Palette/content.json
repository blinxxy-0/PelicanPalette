{
  "Format": "2.9.0",
  "DynamicTokens": [
    { "Name": "ShopId", "Value": "blinxxy.MuseArt_ArtShop" },
    { "Name": "PaintingLevel", "Value": "PLAYER_BLINXXY.MUSEART.PAINTING_LEVEL Current" }
  ],
  "Changes": [
    // The shop's interior: a new location with its own map.
    {
      "Action": "Load",
      "Target": "Maps/blinxxy.MuseArt_ArtShop",
      "FromFile": "assets/ArtShop.tmx"
    },
    // The same room dressed as a gallery, for Sable's exhibition (the
    // 14-heart event switches to it with changeToTemporaryMap).
    {
      "Action": "Load",
      "Target": "Maps/blinxxy.MuseArt_ArtShopGallery",
      "FromFile": "assets/ArtShopGallery.tmx"
    },
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "DisplayName": "{{i18n:location.art-shop}}",
          "DefaultArrivalTile": { "X": 9, "Y": 13 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ArtShop" }
        }
      }
    },

    // The shop on the world map (M): a few pixels over the Forest, west of
    // the path down from Marnie's, with a winter version (the game picks
    // WorldMapShop_winter itself). Drawn by tools/art/world_map_shop.py.
    {
      "Action": "Load",
      "Target": "Mods/blinxxy.MuseArt/WorldMapShop, Mods/blinxxy.MuseArt/WorldMapShop_winter",
      "FromFile": "assets/{{TargetWithoutPath}}.png"
    },
    {
      "Action": "EditData",
      "Target": "Data/WorldMap",
      "TargetField": [ "Valley", "MapAreas", "Forest", "Textures" ],
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "Id": "blinxxy.MuseArt_ArtShop",
          "Texture": "Mods/blinxxy.MuseArt/WorldMapShop",
          "SourceRect": { "X": 0, "Y": 0, "Width": 9, "Height": 7 },
          "MapPixelArea": { "X": 92, "Y": 109, "Width": 9, "Height": 7 }
        }
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/WorldMap",
      "TargetField": [ "Valley", "MapAreas", "Forest", "Tooltips" ],
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "Id": "blinxxy.MuseArt_ArtShop",
          "PixelArea": { "X": 92, "Y": 109, "Width": 9, "Height": 7 },
          "Text": "{{i18n:worldmap.art-shop}}",
          "LeftNeighbor": "Forest/WizardTower",
          "RightNeighbor": "Forest/LeahCottage",
          "UpNeighbor": "Forest/MarnieRanch",
          "DownNeighbor": "Forest/SewerPipe"
        }
      }
    },
    // Inside the shop (and the gallery evening), you're shown at its door.
    {
      "Action": "EditData",
      "Target": "Data/WorldMap",
      "TargetField": [ "Valley", "MapAreas", "Forest", "WorldPositions" ],
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "Id": "blinxxy.MuseArt_ArtShop",
          "LocationNames": [ "blinxxy.MuseArt_ArtShop", "blinxxy.MuseArt_ArtShopGallery" ],
          "MapPixelArea": { "X": 96, "Y": 113, "Width": 1, "Height": 1 }
        }
      },
      "MoveEntries": [ { "ID": "blinxxy.MuseArt_ArtShop", "ToPosition": "Top" } ]
    },

    // The building and its yard, in the quiet grass west of the path down
    // from Marnie's (Leah's cottage is further east). The door leads inside
    // between 9am and 8pm; a gate opens onto the riverside path.
    {
      "Action": "EditMap",
      "Target": "Maps/Forest",
      "FromFile": "assets/ArtShopExteriorPatch.tmx",
      "ToArea": { "X": 76, "Y": 27, "Width": 13, "Height": 12 },
      "PatchMode": "Overlay"
    },

    // Sable, who runs the shop.
    { "Action": "Include", "FromFile": "data/sable.json" },

    // What the shop sells. Stock widens with the Painting skill. It also
    // buys paintings (at a premium; see the C# mod).
    {
      "Action": "EditData",
      "Target": "Data/Shops",
      "Entries": {
        "{{ShopId}}": {
          // Sable serves from behind the counter (see data/sable.json for
          // their hours); otherwise the shop is closed.
          "Owners": [
            {
              "Id": "Sable",
              "Name": "Sable",
              "Condition": "!DAY_OF_WEEK Wednesday",
              "Dialogues": [
                { "Id": "Canvas", "Dialogue": "{{i18n:shop.owner.canvas}}" },
                { "Id": "Pigment", "Dialogue": "{{i18n:shop.owner.pigment}}" },
                { "Id": "Brush", "Dialogue": "{{i18n:shop.owner.brush}}" },
                { "Id": "Selling", "Dialogue": "{{i18n:shop.owner.selling}}" }
              ]
            },
            {
              "Id": "Closed",
              "Name": "None",
              "ClosedMessage": "{{i18n:shop.closed}}"
            }
          ],
          "SalableItemTags": [ "muse_painting" ],
          "Items": [
            { "Id": "Easel", "ItemId": "(BC)blinxxy.MuseArt_Easel", "Price": 300 },
            { "Id": "CanvasSmall", "ItemId": "(O)blinxxy.MuseArt_Canvas_Small", "Price": 25 },
            { "Id": "CanvasMedium", "ItemId": "(O)blinxxy.MuseArt_Canvas_Medium", "Price": 80, "Condition": "{{PaintingLevel}} 4" },
            { "Id": "CanvasLarge", "ItemId": "(O)blinxxy.MuseArt_Canvas_Large", "Price": 200, "Condition": "{{PaintingLevel}} 7" },
            { "Id": "LinenMedium", "ItemId": "(O)blinxxy.MuseArt_Linen_Medium", "Price": 500, "Condition": "{{PaintingLevel}} 8" },
            { "Id": "LinenLarge", "ItemId": "(O)blinxxy.MuseArt_Linen_Large", "Price": 1000, "Condition": "{{PaintingLevel}} 8" },
            { "Id": "Frame", "ItemId": "(O)blinxxy.MuseArt_PictureFrame", "Price": 150 },

            { "Id": "Sienna", "ItemId": "(O)blinxxy.MuseArt_Pigment_sienna", "Price": 120, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "!blinxxy.MuseArt_KNOWS_PIGMENT Current sienna" },
            { "Id": "Rose", "ItemId": "(O)blinxxy.MuseArt_Pigment_rose", "Price": 120, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "!blinxxy.MuseArt_KNOWS_PIGMENT Current rose" },
            { "Id": "Marigold", "ItemId": "(O)blinxxy.MuseArt_Pigment_marigold", "Price": 120, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "!blinxxy.MuseArt_KNOWS_PIGMENT Current marigold" },
            { "Id": "Leaf", "ItemId": "(O)blinxxy.MuseArt_Pigment_leaf", "Price": 120, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "!blinxxy.MuseArt_KNOWS_PIGMENT Current leaf" },
            { "Id": "Peach", "ItemId": "(O)blinxxy.MuseArt_Pigment_peach", "Price": 120, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "!blinxxy.MuseArt_KNOWS_PIGMENT Current peach" },
            { "Id": "Snow", "ItemId": "(O)blinxxy.MuseArt_Pigment_snow", "Price": 200, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "{{PaintingLevel}} 3, !blinxxy.MuseArt_KNOWS_PIGMENT Current snow" },
            { "Id": "Plum", "ItemId": "(O)blinxxy.MuseArt_Pigment_plum", "Price": 200, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "{{PaintingLevel}} 3, !blinxxy.MuseArt_KNOWS_PIGMENT Current plum" },
            { "Id": "Cerulean", "ItemId": "(O)blinxxy.MuseArt_Pigment_cerulean", "Price": 200, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "{{PaintingLevel}} 3, !blinxxy.MuseArt_KNOWS_PIGMENT Current cerulean" },
            { "Id": "Violet", "ItemId": "(O)blinxxy.MuseArt_Pigment_violet", "Price": 1500, "AvailableStock": 1, "AvailableStockLimit": "Player", "Condition": "{{PaintingLevel}} 8, !blinxxy.MuseArt_KNOWS_PIGMENT Current violet" },

            // Palettes (each tier holds more of each colour), and paint for every
            // colour you know (tubes go straight into your Palette). The Pigment
            // Mill grinds your own.
            { "Id": "Palette", "ItemId": "(O)blinxxy.MuseArt_Palette", "Price": 150 },
            { "Id": "PaletteEnamel", "ItemId": "(O)blinxxy.MuseArt_Palette_Enamel", "Price": 2500, "Condition": "{{PaintingLevel}} 5" },
            { "Id": "PaletteIridium", "ItemId": "(O)blinxxy.MuseArt_Palette_Iridium", "Price": 12000, "Condition": "{{PaintingLevel}} 9" },
            { "Id": "PigmentMill", "ItemId": "(BC)blinxxy.MuseArt_PigmentMill", "Price": 1000 },
            // Varnishing, from Painting level 7: tins of Varnish and the cabinet that cures them.
            { "Id": "Varnish", "ItemId": "(O)blinxxy.MuseArt_Varnish", "Price": 120, "Condition": "{{PaintingLevel}} 7" },
            { "Id": "VarnishCabinet", "ItemId": "(BC)blinxxy.MuseArt_VarnishCabinet", "Price": 3000, "Condition": "{{PaintingLevel}} 7" },
            { "Id": "TubeCharcoal", "ItemId": "(O)blinxxy.MuseArt_Tube_charcoal", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current charcoal" },
            { "Id": "TubeUmber", "ItemId": "(O)blinxxy.MuseArt_Tube_umber", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current umber" },
            { "Id": "TubeSienna", "ItemId": "(O)blinxxy.MuseArt_Tube_sienna", "Price": 12, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current sienna" },
            { "Id": "TubeOchre", "ItemId": "(O)blinxxy.MuseArt_Tube_ochre", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current ochre" },
            { "Id": "TubeCream", "ItemId": "(O)blinxxy.MuseArt_Tube_cream", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current cream" },
            { "Id": "TubeStone", "ItemId": "(O)blinxxy.MuseArt_Tube_stone", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current stone" },
            { "Id": "TubeCrimson", "ItemId": "(O)blinxxy.MuseArt_Tube_crimson", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current crimson" },
            { "Id": "TubeRose", "ItemId": "(O)blinxxy.MuseArt_Tube_rose", "Price": 12, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current rose" },
            { "Id": "TubeMarigold", "ItemId": "(O)blinxxy.MuseArt_Tube_marigold", "Price": 12, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current marigold" },
            { "Id": "TubeMoss", "ItemId": "(O)blinxxy.MuseArt_Tube_moss", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current moss" },
            { "Id": "TubeLeaf", "ItemId": "(O)blinxxy.MuseArt_Tube_leaf", "Price": 12, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current leaf" },
            { "Id": "TubeSlate", "ItemId": "(O)blinxxy.MuseArt_Tube_slate", "Price": 8, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current slate" },
            { "Id": "TubeCerulean", "ItemId": "(O)blinxxy.MuseArt_Tube_cerulean", "Price": 20, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current cerulean" },
            { "Id": "TubePlum", "ItemId": "(O)blinxxy.MuseArt_Tube_plum", "Price": 20, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current plum" },
            { "Id": "TubeSnow", "ItemId": "(O)blinxxy.MuseArt_Tube_snow", "Price": 20, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current snow" },
            { "Id": "TubeViolet", "ItemId": "(O)blinxxy.MuseArt_Tube_violet", "Price": 60, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current violet" },
            { "Id": "TubeAquamarine", "ItemId": "(O)blinxxy.MuseArt_Tube_aquamarine", "Price": 60, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current aquamarine" },
            { "Id": "TubeRuby", "ItemId": "(O)blinxxy.MuseArt_Tube_ruby", "Price": 60, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current ruby" },
            { "Id": "TubePeach", "ItemId": "(O)blinxxy.MuseArt_Tube_peach", "Price": 12, "Condition": "blinxxy.MuseArt_KNOWS_PIGMENT Current peach" },

            { "Id": "BrushFlat", "ItemId": "(O)blinxxy.MuseArt_Brush_flat", "Price": 400, "Condition": "{{PaintingLevel}} 2" },
            { "Id": "BrushSable", "ItemId": "(O)blinxxy.MuseArt_Brush_sable", "Price": 900, "Condition": "{{PaintingLevel}} 3" },
            { "Id": "BrushRigger", "ItemId": "(O)blinxxy.MuseArt_Brush_rigger", "Price": 1200, "Condition": "{{PaintingLevel}} 6" },
            { "Id": "BrushIridium", "ItemId": "(O)blinxxy.MuseArt_Brush_iridium", "Price": 7500, "Condition": "{{PaintingLevel}} 9" }
          ]
        }
      }
    }
  ]
}
