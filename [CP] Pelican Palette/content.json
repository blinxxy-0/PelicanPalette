{
  "Format": "2.9.0",
  "DynamicTokens": [
    { "Name": "ShopId", "Value": "blinxxy.MuseArt_ArtShop" },
    { "Name": "PaintingLevel", "Value": "PLAYER_BLINXXY.MUSEART.PAINTING_LEVEL Current" }
  ],
  "Changes": [
    // The shop's interior: a new location with its own map.
    {
      "Action": "Load",
      "Target": "Maps/blinxxy.MuseArt_ArtShop",
      "FromFile": "assets/ArtShop.tmx"
    },
    // The same room dressed as a gallery, for Sable's exhibition (the
    // 14-heart event switches to it with changeToTemporaryMap).
    {
      "Action": "Load",
      "Target": "Maps/blinxxy.MuseArt_ArtShopGallery",
      "FromFile": "assets/ArtShopGallery.tmx"
    },
    // The back room (1.2), through the door in the shop's back wall: the
    // portfolio book, the plan chest, and the trapdoor down to Sable's room.
    // Built by tools/build_back_room.py.
    {
      "Action": "Load",
      "Target": "Maps/blinxxy.MuseArt_ArtShopBackRoom",
      "FromFile": "assets/ArtShopBackRoom.tmx"
    },
    // Sable's room under the shop, down the trapdoor in the back room
    // (2 hearts, or the key to the town; ArtShop.cs). Built by
    // tools/build_sable_basement.py from Sebastian's basement room.
    {
      "Action": "Load",
      "Target": "Maps/blinxxy.MuseArt_SableBasement",
      "FromFile": "assets/SableBasement.tmx"
    },
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "DisplayName": "{{i18n:location.art-shop}}",
          "DefaultArrivalTile": { "X": 9, "Y": 13 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ArtShop" }
        },
        "blinxxy.MuseArt_ArtShopBackRoom": {
          "DisplayName": "{{i18n:location.art-shop}}",
          "DefaultArrivalTile": { "X": 5, "Y": 9 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_ArtShopBackRoom" }
        },
        "blinxxy.MuseArt_SableBasement": {
          "DisplayName": "{{i18n:location.sable-room}}",
          "DefaultArrivalTile": { "X": 1, "Y": 2 },
          "CreateOnLoad": { "MapPath": "Maps/blinxxy.MuseArt_SableBasement" }
        }
      }
    },

    // The shop on the world map (M): a few pixels over the Forest, west of
    // the path down from Marnie's, with a winter version (the game picks
    // WorldMapShop_winter itself). Drawn by tools/art/world_map_shop.py.
    {
      "Action": "Load",
      "Target": "Mods/blinxxy.MuseArt/WorldMapShop, Mods/blinxxy.MuseArt/WorldMapShop_winter",
      "FromFile": "assets/{{TargetWithoutPath}}.png"
    },
    {
      "Action": "EditData",
      "Target": "Data/WorldMap",
      "TargetField": [ "Valley", "MapAreas", "Forest", "Textures" ],
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "Id": "blinxxy.MuseArt_ArtShop",
          "Texture": "Mods/blinxxy.MuseArt/WorldMapShop",
          "SourceRect": { "X": 0, "Y": 0, "Width": 9, "Height": 7 },
          "MapPixelArea": { "X": 92, "Y": 109, "Width": 9, "Height": 7 }
        }
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/WorldMap",
      "TargetField": [ "Valley", "MapAreas", "Forest", "Tooltips" ],
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "Id": "blinxxy.MuseArt_ArtShop",
          "PixelArea": { "X": 92, "Y": 109, "Width": 9, "Height": 7 },
          "Text": "{{i18n:worldmap.art-shop}}",
          "LeftNeighbor": "Forest/WizardTower",
          "RightNeighbor": "Forest/LeahCottage",
          "UpNeighbor": "Forest/MarnieRanch",
          "DownNeighbor": "Forest/SewerPipe"
        }
      }
    },
    // Inside the shop (and the gallery evening), you're shown at its door.
    {
      "Action": "EditData",
      "Target": "Data/WorldMap",
      "TargetField": [ "Valley", "MapAreas", "Forest", "WorldPositions" ],
      "Entries": {
        "blinxxy.MuseArt_ArtShop": {
          "Id": "blinxxy.MuseArt_ArtShop",
          "LocationNames": [ "blinxxy.MuseArt_ArtShop", "blinxxy.MuseArt_ArtShopGallery", "blinxxy.MuseArt_ArtShopBackRoom", "blinxxy.MuseArt_SableBasement" ],
          "MapPixelArea": { "X": 96, "Y": 113, "Width": 1, "Height": 1 }
        }
      },
      "MoveEntries": [ { "ID": "blinxxy.MuseArt_ArtShop", "ToPosition": "Top" } ]
    },

    // The building and its yard, in the quiet grass west of the path down
    // from Marnie's (Leah's cottage is further east). The door leads inside
    // between 9am and 8pm; a gate opens onto the riverside path.
    {
      "Action": "EditMap",
      "Target": "Maps/Forest",
      "When": { "blinxxy.MuseArt/ShopMoved": "false" },
      "FromFile": "assets/ArtShopExteriorPatch.tmx",
      "ToArea": { "X": 76, "Y": 27, "Width": 13, "Height": 12 },
      "PatchMode": "Overlay",
      // Last, after other mods' forest edits: Alec Revisited's house patch
      // (Forest 70-83, 19-31, a Replace) and its SVE patch otherwise paint
      // over the shop's roof and left side (2026-11-03, reported on Nexus).
      "Priority": "Late"
    },
